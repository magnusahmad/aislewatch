  "gemini-3.8-flash": {
    "kind": "api",
    "provider": "openrouter",
    "base_url": "https://openrouter.ai/api/v1",
    "model": "google/gemini-3.8-flash",
    "api_key_env": "OPENROUTER_API_KEY",
    "price": {
      "usd_per_m_input": 0.75,
      "usd_per_m_output": 3.75,
      "checked": "2026-10-13",
      "note": "OpenRouter list price, standard tier. Announced to double from 2027-01-01. Reasoning is mandatory on this endpoint; set to minimal, which still uses ~380 reasoning tokens on 10-frame inputs, so max_tokens is raised to 2000 to let the JSON finish. Reasoning tokens are billed."
    },
    "extra_body": {
      "reasoning": {
        "effort": "minimal"
      },
      "max_tokens": 2000
    }
  },
  "gpt-6.1-sol": {
    "kind": "api",
    "provider": "openrouter",
    "base_url": "https://openrouter.ai/api/v1",
    "model": "openai/gpt-6.1-sol",
    "api_key_env": "OPENROUTER_API_KEY",
    "price": {
      "usd_per_m_input": 2.0,
      "usd_per_m_output": 10.0,
      "checked": "2026-10-13",
      "note": "OpenRouter list price, standard tier. Reasoning set to minimal (default reasoning truncated JSON at max_tokens=400; matches thinking-off Qwen). Cost shown on the showcase is estimated from this list price."
    },
    "extra_body": {
      "reasoning": {
        "effort": "minimal"
      }
    }
  },
